{
  "seed": 42,
  "device": "cuda_if_available",
  "dataset": {
    "name": "cifar10",
    "data_dir": "./data",
    "batch_size": 128,
    "grayscale": false,
    "resize": 32,
    "normalize": {
      "mean": [
        0.4914,
        0.4822,
        0.4465
      ],
      "std": [
        0.247,
        0.2435,
        0.2616
      ]
    }
  },
  "training": {
    "epochs": 20,
    "lr": 0.001
  },
  "selected_trial": {
    "layers_2d": [
      {
        "rf": 3,
        "overlap": 2,
        "activation": "relu",
        "inhibition": {
          "enabled": true,
          "mode": "fixed",
          "delta": 1.0,
          "h": 1
        }
      },
      {
        "rf": 3,
        "overlap": 1,
        "activation": "relu",
        "inhibition": {
          "enabled": true,
          "mode": "radial",
          "h": 1,
          "radial_init_mu": 1.5,
          "radial_init_sigma": 1.0
        },
        "channels": 3
      },
      {
        "rf": 3,
        "overlap": 1,
        "activation": "relu",
        "inhibition": {
          "enabled": true,
          "mode": "radial",
          "h": 1,
          "radial_init_mu": 1.0,
          "radial_init_sigma": 0.8
        }
      }
    ],
    "decoder_hidden": [
      128
    ],
    "decoder": {
      "type": "pyramid",
      "start_size": 8,
      "start_channels": 32,
      "channels": [
        32,
        16
      ],
      "activation": "relu"
    }
  },
  "model": {
    "input_size": 32,
    "input_channels": 3
  }
}
